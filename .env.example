# Copy to .env and fill in locally. Never commit real values.
# Everything is optional: with no variables set, the demo runs fully in memory
# with the deterministic mock extractor.

# review-queue HTTP demo
PORT=
EXTRACTOR=
IDLE_AFTER_DAYS=

# Optional LLM-backed extractor / classifier (read by the Anthropic SDK)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Postgres store (any libpq connection string)
DATABASE_URL=
